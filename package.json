{
  "name": "consoltant-roadmap",
  "version": "0.1.0",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:desktop": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build:electron": "node scripts/generate-env.js && tsc -p desktop/tsconfig.json",
    "build:desktop": "npm run build && npm run build:electron",
    "pack:windows": "npm run build:desktop && electron-builder --win"
  },
  "build": {
    "appId": "com.mrnumberone.onepath",
    "productName": "OnePath",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/dist/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app.asar.unpacked/standalone",
        "filter": ["**/*", "!node_modules", "!node_modules/**/*"]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app.asar.unpacked/standalone/node_modules"
      },
      {
        "from": ".next/static",
        "to": "app.asar.unpacked/standalone/.next/static"
      },
      {
        "from": "public",
        "to": "app.asar.unpacked/standalone/public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/android-chrome-512x512.png"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
