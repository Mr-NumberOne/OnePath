{
  "name": "consoltant-roadmap",
  "version": "0.1.0",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:desktop": "npm run build:electron && concurrently \"npm run dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build:electron": "node scripts/generate-env.js && tsc -p desktop/tsconfig.json && esbuild desktop/dist/main.js --bundle --platform=node --target=node22 --external:electron --outfile=desktop/dist/main.js --allow-overwrite --log-level=warning",
    "build:desktop": "npm run build && npm run build:electron",
    "pack:windows": "npm run build:desktop && electron-builder --win --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.25.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^28.1.0",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wait-on": "^9.1.0"
  }
}
