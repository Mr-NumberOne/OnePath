AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
AUTH_SECRET=your_random_secret_string
AUTH_GOOGLE_DESKTOP_ID=your_google_desktop_client_id_here
AUTH_GOOGLE_DESKTOP_SECRET=your_google_desktop_secret_here
AUTH_TRUST_HOST=true

# Optional: folder where the web server keeps custom-roadmap.json.
# Defaults to src/data inside the project. Set it to a writable, persistent
# folder when deploying (the project folder may be read-only or wiped on deploy).
# Desktop builds always set this to the user's AppData folder at runtime.
# ONEPATH_DATA_DIR=/var/lib/onepath
