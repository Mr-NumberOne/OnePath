AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
AUTH_SECRET=your_random_secret_string
AUTH_GOOGLE_DESKTOP_ID=your_google_desktop_client_id_here
